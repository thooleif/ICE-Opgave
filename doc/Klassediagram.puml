@startuml FitnessDomainModel

title Fitness Program — Domain Model

class User {
  + userId : UUID
  + name : String
  + email : String
  --
  + register() : void
  + login() : void
}

class UserProfile {
  + age : Int
  + gender : Enum {Male, Female}
  + heightCm : Float
  + weightKg : Float
  + experienceLevel : Enum {Beginner, novice, Intermediate, Advanced}
  + injuryNotes : String
  --
  + updateStats() : void
  + calculateBMI() : Float
  + setExperienceLevel() : void
  + addInjuryNote(String) : void
}

class FitnessGoal {
  + goalType : Enum {BulkUp, LoseWeight, Maintain, Recomp}
  + targetWeightKg : Float
  + startWeightKg : Float
  + deadlineDate : Date
  + weeklyWeightChangeKg : Float
  --
  + setGoal() : void
  + updateGoal() : void
  + calculateWeeklyTarget() : Float
  + isGoalReached() : Boolean
}

class TrainingPreference {
  + wantsStrength : Boolean
  + wantsCardio : Boolean
  + programFocus : Enum {GeneralLifestyle, Bodybuilding, SpecificSport, Other}
  + sportSpecification : String
  + trainingDaysPerWeek : Int
  + sessionDurationMin : Int
  --
  + setPreferences() : void
  + updatePreferences() : void
  + getRecommendedSplit() : String
}

class FitnessProgram {
  + programId : UUID
  + createdDate : Date
  + status : Enum {Active, Completed}
  + durationWeeks : Int
  --
  + completeProgram() : void
  + generateProgram() : void
}

class MacroPlan {
  + calorieGoal : Int
  + proteinGram : Int
  + carbohydrateGram : Int
  + fatGram : Int
  + calculationMethod : String
  + adjustmentFactor : Float
  --
  + calculateMacros() : void
  + adjustCalories(amount : Int) : void
  + getMacroSplit() : String
  + recalculate() : void
}

class TrainingPlan {
  + planId : UUID
  + name : String
  + weeklyStructure : String
  + injuryConsiderations : String[]
  --
  + createPlan() : void
  + updatePlan() : void
  + getWeeklyOverview() : String
}

class TrainingWeek {
  + weekNumber : Int
  + startDate : Date
  + endDate : Date
  + status : Enum {Planned, Active, Completed}
  --
  + completeWeek() : void
  + getDaysOverview() : List
}

class TrainingDay {
  + dayNumber : Int
  + dayName : String
  + focus : Enum {Push, Pull, Legs, FullBody, Cardio, Rest}
  + estimatedDuration : Int
  --
  + startSession() : void
  + completeSession() : void
  + getExerciseList() : List
}

class ExerciseCatalog <<ExternalAPI>> {
  --
  + getExercisesByLevel(level : Enum) : List
  + getExercisesByMuscleGroup(group : String) : List
  + getAlternativeExercises(exerciseId : UUID) : List
}

class Exercise {
  + exerciseId : UUID
  + name : String
  + muscleGroups : String[]
  + equipment : String
  + experienceLevel : Enum
  + injuryFriendly : Boolean
  + videoUrl : String
  --
  + getDetails() : String
  + getAlternatives() : List
}

class ProgramExercise {
  + sets : Int
  + reps : String
  + restTimeSec : Int
  + progressionNote : String
  + alternativeExercise : String
  --
  + updateSetsReps(sets : Int, reps : String) : void
  + swapExercise(exerciseId : UUID) : void
  + addProgressionNote(note : String) : void
}

class WeeklyWeighIn {
  + weighInId : UUID
  + date : Date
  + weightKg : Float
  + weekNumber : Int
  --
  + logWeight(weight : Float) : void
  + getWeighInHistory() : List
}

class WeightProgress {
  + totalChangeKg : Float
  + averageChangePerWeek : Float
  --
  + calculateProgress() : void
  + getProgressReport() : String
}

class MacroAdjustment {
  + oldCalories : Int
  + newCalories : Int
  + recommendation : String
  --
  + triggerAdjustment() : void
  + getAdjustmentHistory() : List
}

class UserInputHandler <<Scanner>> {
  - scanner : Scanner
  --
  + readName() : String
  + readAge() : Int
  + readHeight() : Float
  + readWeight() : Float
  + readGender() : Enum
  + readExperienceLevel() : Enum
  + readGoalType() : Enum
  + readTargetWeight() : Float
  + readTrainingPreferences() : TrainingPreference
  + readWeeklyWeighIn() : Float
  + readProgramFocus() : Enum
  + closeScanner() : void
}

